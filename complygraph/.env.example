# --- LLM (leave unset to run in deterministic offline mode) ---
COMPLYGRAPH_LLM_PROVIDER=anthropic        # anthropic | openai | offline
COMPLYGRAPH_LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                           # also used for Azure/OpenAI-compatible via OPENAI_BASE_URL
# --- Retrieval (LlamaIndex). Empty = built-in BM25 ---
COMPLYGRAPH_EMBED_MODEL=                  # e.g. local:BAAI/bge-small-en-v1.5
# --- Agent tooling ---
COMPLYGRAPH_USE_MCP=0                     # 1 = load tools from config/mcp_servers.json via MCP
COMPLYGRAPH_SCAN_ROOTS=./examples         # os.pathsep list of dirs the API/MCP may scan
# --- Governance ---
COMPLYGRAPH_STATE_DIR=./.state
COMPLYGRAPH_AUDIT_HMAC_KEY=               # set in prod; signs the audit chain
COMPLYGRAPH_API_KEYS=dev-analyst:alice:analyst,dev-approver:bob:approver
